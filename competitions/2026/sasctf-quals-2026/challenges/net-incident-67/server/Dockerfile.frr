FROM frrouting/frr:latest

RUN apk add --no-cache \
    openssh-server \
    bash \
    tcpdump \
    iputils \
    bind-tools \
    curl

RUN ssh-keygen -A && \
    adduser -D -s /bin/bash player && \
    echo "player:player" | chpasswd && \
    echo "root:41f8465c805ec9c49d28924b54346a7b" | chpasswd && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    mkdir -p /run/sshd && \
    usermod -aG frrvty player 2>/dev/null || addgroup player frrvty 2>/dev/null || true

RUN printf '#!/bin/sh\nset -e\nsysctl -w net.ipv4.ip_forward=1 2>/dev/null || true\nfor iface in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 0 > "$iface" 2>/dev/null || true; done\nchown -R frr:frr /var/run/frr /var/tmp/frr 2>/dev/null || true\n/usr/sbin/sshd 2>/dev/null || true\nexec /usr/lib/frr/docker-start\n' > /start.sh && \
    chmod +x /start.sh

EXPOSE 22 179 2601 2605

ENTRYPOINT ["/start.sh"]

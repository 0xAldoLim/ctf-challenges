diff --git a/hw/riscv/gatekeeper_uart.c b/hw/riscv/gatekeeper_uart.c
new file mode 100644
index 0000000000..68501a2a9d
--- /dev/null
+++ b/hw/riscv/gatekeeper_uart.c
@@ -0,0 +1,143 @@
+#include "qemu/osdep.h"
+#include "hw/riscv/gatekeeper_uart.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "qemu/typedefs.h"
+#include "qom/object.h"
+#include "system/memory.h"
+#include <stdint.h>
+
+// OBJECT_DECLARE_SIMPLE_TYPE(GatekeeperUartState, GATEKEEPER_UART)
+
+struct GatekeeperUartState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+
+    uint8_t thr;
+    uint8_t lsr;
+
+    int32_t rx_buf; /* one-byte lookahead; -1 == empty */
+    bool rx_eof;    /* set once stdin reaches EOF */
+};
+
+/*
+ * Pull one byte of input into the lookahead buffer if it is empty. Input comes
+ * from QEMU's stdin (the eventual websocket transport is piped into stdin).
+ * getchar() blocks until a byte arrives or EOF, giving readc() blocking-read
+ * semantics on this single-hart board.
+ */
+static void gatekeeper_uart_rx_fill(GatekeeperUartState *s) {
+    if (s->rx_buf != -1 || s->rx_eof) {
+        return;
+    }
+    int c = getchar();
+    if (c == EOF) {
+        s->rx_eof = true;
+    } else {
+        s->rx_buf = c & 0xFF;
+    }
+}
+
+static uint64_t gatekeeper_uart_read (
+    void *opaque,
+    hwaddr offset,
+    uint32_t len
+) {
+    GatekeeperUartState *s = (GatekeeperUartState *)opaque;
+    switch (offset) {
+        case UART_RHR: {
+            /* Consume and return the pending byte, or 0 at EOF. */
+            gatekeeper_uart_rx_fill(s);
+            if (s->rx_buf != -1) {
+                uint8_t c = (uint8_t)s->rx_buf;
+                s->rx_buf = -1;
+                return c;
+            }
+            return 0;
+        }
+
+        case UART_LSR: {
+            /* Always ready to transmit; DR set iff a byte is available. */
+            gatekeeper_uart_rx_fill(s);
+            uint8_t lsr = UART_LSR_THRE | UART_LSR_TEMT;
+            if (s->rx_buf != -1) {
+                lsr |= UART_LSR_DR;
+            }
+            return lsr;
+        }
+
+        default:
+            return UINT8_MAX;
+    }
+}
+
+static void gatekeeper_uart_write(
+    void *opaque,
+    hwaddr offset,
+    uint64_t val,
+    unsigned size
+) {
+    GatekeeperUartState *s = (GatekeeperUartState *)opaque;
+    switch (offset) {
+        case UART_THR:
+            s->thr = val & 0xFF;
+            putchar((char)val);
+            fflush(stdout);
+            break;
+
+        default:
+            break;
+    }
+}
+
+static const MemoryRegionOps gatekeeeper_uart_ops = {
+    .read = gatekeeper_uart_read,
+    .write = gatekeeper_uart_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = {
+        .min_access_size = 1,
+        .max_access_size = 1,
+    },
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 1,
+    }
+};
+
+static void gatekeeper_uart_realize(DeviceState *dev, Error **errp) {
+    GatekeeperUartState *s = GATEKEEPER_UART(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    s->rx_buf = -1;
+    s->rx_eof = false;
+
+    memory_region_init_io(
+        &s->mmio, 
+        OBJECT(s),
+        &gatekeeeper_uart_ops,
+        s,
+        "gatekeeeper.uart",
+        GATEKEEPER_UART_SIZE
+    );
+
+    sysbus_init_mmio(sbd, &s->mmio);
+}
+
+static void gatekeeper_uart_class_init(ObjectClass *klass, const void *data) {
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = gatekeeper_uart_realize;
+    dc->desc = "UART input/output device";
+}
+
+static const TypeInfo gatekeeper_uart_info = {
+    .name = TYPE_GATEKEEPER_UART,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(GatekeeperUartState),
+    .class_init = gatekeeper_uart_class_init,
+};
+
+static void gatekeeper_uart_register_types(void) {
+    type_register_static(&gatekeeper_uart_info);
+}
+
+type_init(gatekeeper_uart_register_types);

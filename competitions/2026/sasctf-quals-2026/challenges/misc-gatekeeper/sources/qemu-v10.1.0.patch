@@ -0,0 +1,24 @@
+#ifndef HW_RISCV_GATEKEEPER_BOARD_H
+#define HW_RISCV_GATEKEEPER_BOARD_H
+
+#include "hw/boards.h"
+
+#define TYPE_GATEKEEPER_BOARD MACHINE_TYPE_NAME("gatekeeper")
+
+#define GATEKEEPER_CODE_BASE 0x300000
+#define GATEKEEPER_CODE_SIZE 0x10000
+
+#define GATEKEEPER_DATA_BASE (GATEKEEPER_CODE_BASE + GATEKEEPER_CODE_SIZE)
+#define GATEKEEPER_DATA_SIZE 0x10000
+
+#define GATEKEEPER_STACK_BASE (GATEKEEPER_DATA_BASE + GATEKEEPER_DATA_SIZE)
+#define GATEKEEPER_STACK_SIZE 0x20000
+
+/* U-mode trusted-lib window (the wrappers that ecall the monitor). */
+#define GATEKEEPER_TRUSTED_LIB_BASE 0x80000000
+#define GATEKEEPER_TRUSTED_LIB_SIZE 0x10000
+
+/* M-mode monitor lives above the U-mode trusted-lib window, in the same RAM. */
+#define GATEKEEPER_MONITOR_BASE 0x80010000
+
+#endif // HW_RISCV_GATEKEEPER_BOARD_H

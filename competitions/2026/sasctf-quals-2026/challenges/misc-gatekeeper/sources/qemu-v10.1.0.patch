diff --git a/hw/riscv/gatekeeper_board.c b/hw/riscv/gatekeeper_board.c
new file mode 100644
index 0000000000..e513e67f26
--- /dev/null
+++ b/hw/riscv/gatekeeper_board.c
@@ -0,0 +1,147 @@
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "hw/riscv/gatekeeper_board.h"
+#include "hw/riscv/gatekeeper_uart.h"
+#include "hw/riscv/gatekeeper_device.h"
+#include "hw/boards.h"
+#include "hw/qdev-properties.h"
+#include "hw/loader.h"
+#include "hw/sysbus.h"
+#include "hw/riscv/gatekeeper_uart.h"
+#include "system/address-spaces.h"
+#include "target/riscv/cpu.h"
+#include "qemu/log.h"
+
+extern unsigned char build_trusted_lib_bin[]; /* U-mode trusted-lib (wraps ecalls) */
+extern unsigned int build_trusted_lib_bin_len;
+
+extern unsigned char build_monitor_bin[];
+extern unsigned int build_monitor_bin_len;
+
+enum {
+    GATEKEEPER_UART0,
+    GATEKEEPER_MMIO_DEV,
+    GATEKEEPER_HANDLES,
+    GATEKEEPER_TRUSTED_FUNCS_RAM,
+    GATEKEEPER_EXE_RAM,
+    GATEKEEPER_STACK,
+    GATEKEEPER_DATA,
+    GATEKEEPER_CODE,
+    GATEKEEPER_TRUSTED_FUNCS,
+};
+
+static const MemMapEntry gatekeeper_memmap[] = {
+    [GATEKEEPER_UART0] =             {0x10000000, 0x100},
+    [GATEKEEPER_MMIO_DEV] =          {0x13370000, 0x1000},
+    [GATEKEEPER_HANDLES] =           {0x13400000, 0x80000},
+    [GATEKEEPER_TRUSTED_FUNCS_RAM] = {0x80000000, 0x50000},
+    [GATEKEEPER_TRUSTED_FUNCS] =     {GATEKEEPER_TRUSTED_LIB_BASE, GATEKEEPER_TRUSTED_LIB_SIZE},
+    [GATEKEEPER_EXE_RAM] =           {GATEKEEPER_CODE_BASE, GATEKEEPER_CODE_SIZE + GATEKEEPER_DATA_SIZE + GATEKEEPER_STACK_SIZE},
+    [GATEKEEPER_CODE] =              {GATEKEEPER_CODE_BASE, GATEKEEPER_CODE_SIZE},
+    [GATEKEEPER_DATA] =              {GATEKEEPER_DATA_BASE, GATEKEEPER_DATA_SIZE},    
+    [GATEKEEPER_STACK] =             {GATEKEEPER_STACK_BASE, GATEKEEPER_STACK_SIZE},
+};
+
+/* GATEKEEPER Board State */
+typedef struct GatekeeperBoardState GatekeeperBoardState;
+
+struct GatekeeperBoardState{
+    MachineState parent;
+    RISCVCPU *cpu;
+    MemoryRegion ram_trusted_funcs;
+    MemoryRegion ram_executable;
+    DeviceState *uart;
+    DeviceState *gatekeeper;
+    const MemMapEntry *memmap;
+};
+
+#define TYPE_GATEKEEPER_BOARD MACHINE_TYPE_NAME("gatekeeper")
+OBJECT_DECLARE_SIMPLE_TYPE(GatekeeperBoardState, GATEKEEPER_BOARD)
+
+static void setup_cpu_registers(GatekeeperBoardState *s) {
+    CPURISCVState *env = &s->cpu->env;
+
+    for (int i = 0; i < 32; ++i) {
+        env->gpr[i] = 0;
+    }
+
+    /* Reset into the M-mode monitor. It programs PMP, enters U-mode, and seeds
+       the guest GPRs (sp/fp = stack top, ra = code base) before mret. */
+    env->pc = GATEKEEPER_MONITOR_BASE;
+}
+
+static void gatekeeper_board_init(MachineState *machine) {
+    GatekeeperBoardState *s = GATEKEEPER_BOARD(machine);
+    s->memmap = gatekeeper_memmap;
+    MemoryRegion *system_memory = get_system_memory();
+
+    
+    s->cpu = RISCV_CPU(object_new(machine->cpu_type));
+    /* Smepmp (mseccfg.MML): lets the monitor forbid M-mode from executing
+       U-mode memory, so a hijacked control flow can't run guest gadgets in M. */
+    object_property_set_bool(OBJECT(s->cpu), "smepmp", true, &error_fatal);
+    object_property_set_bool(OBJECT(s->cpu), "realized", true, &error_fatal);
+    
+    memory_region_init_ram(&s->ram_trusted_funcs, NULL, "gatekeeper.ram-trusted-funcs", s->memmap[GATEKEEPER_TRUSTED_FUNCS_RAM].size, &error_fatal);
+    memory_region_add_subregion(system_memory, s->memmap[GATEKEEPER_TRUSTED_FUNCS_RAM].base, &s->ram_trusted_funcs);
+
+    memory_region_init_ram(&s->ram_executable, NULL, "gatekeeper.ram-executable", s->memmap[GATEKEEPER_EXE_RAM].size, &error_fatal);
+    memory_region_add_subregion(system_memory, s->memmap[GATEKEEPER_EXE_RAM].base, &s->ram_executable);
+
+    uint8_t *ram_trusted_funcs_ptr = (uint8_t *)memory_region_get_ram_ptr(&s->ram_trusted_funcs);
+    memset(ram_trusted_funcs_ptr, 0, s->memmap[GATEKEEPER_TRUSTED_FUNCS_RAM].size);
+    /* U-mode trusted-lib blob at the window base (0x80000000); M-mode monitor
+       above it at GATEKEEPER_MONITOR_BASE. Both live in this trusted-funcs RAM. */
+    memcpy(ram_trusted_funcs_ptr + (GATEKEEPER_TRUSTED_LIB_BASE - s->memmap[GATEKEEPER_TRUSTED_FUNCS_RAM].base),
+           build_trusted_lib_bin, build_trusted_lib_bin_len);
+    memcpy(ram_trusted_funcs_ptr + (GATEKEEPER_MONITOR_BASE - s->memmap[GATEKEEPER_TRUSTED_FUNCS_RAM].base),
+           build_monitor_bin, build_monitor_bin_len);
+
+    s->uart = qdev_new(TYPE_GATEKEEPER_UART);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(s->uart), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(s->uart), 0, s->memmap[GATEKEEPER_UART0].base);
+    
+    s->gatekeeper = qdev_new(TYPE_GATEKEEPER_DEVICE);
+    object_property_set_link(OBJECT(s->gatekeeper), "system-memory", OBJECT(get_system_memory()), &error_fatal);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(s->gatekeeper), &error_fatal);
+    sysbus_mmio_map(SYS_BUS_DEVICE(s->gatekeeper), 0, s->memmap[GATEKEEPER_MMIO_DEV].base);
+
+    if (machine->firmware) {
+        ssize_t loaded_size = load_image_targphys(machine->firmware, s->memmap[GATEKEEPER_CODE].base, s->memmap[GATEKEEPER_EXE_RAM].size);
+        if (loaded_size < 0) {
+            error_report("Could not load program file '%s'", machine->firmware);
+            exit(1);
+        }
+    }
+    else {
+        error_report("Cannot start without firmware");
+        exit(1);
+    }
+
+    setup_cpu_registers(s);
+}
+
+static void gatekeeper_board_machine_class_init(ObjectClass *oc, const void *data) {
+    MachineClass *mc = MACHINE_CLASS(oc);
+    
+    mc->desc = "GATEKEEPER Board";
+    mc->init = gatekeeper_board_init;
+    mc->max_cpus = 1;
+    mc->default_cpu_type = TYPE_RISCV_CPU_BASE;
+    // mc->default_ram_id = "gatekeeper.ram";
+    // mc->default_ram_id = NUL
+}
+
+static const TypeInfo gatekeeper_board_machine_typeinfo = {
+    .name       = TYPE_GATEKEEPER_BOARD,
+    .parent     = TYPE_MACHINE,
+    .class_init = gatekeeper_board_machine_class_init,
+    .instance_size = sizeof(GatekeeperBoardState),
+};
+
+static void gatekeeper_board_machine_init_register_types(void) {
+    type_register_static(&gatekeeper_board_machine_typeinfo);
+}
+
+type_init(gatekeeper_board_machine_init_register_types)
diff --git a/hw/riscv/gatekeeper_device.c b/hw/riscv/gatekeeper_device.c
new file mode 100644
index 0000000000..3ea332722c
--- /dev/null
+++ b/hw/riscv/gatekeeper_device.c
@@ -0,0 +1,448 @@
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/riscv/gatekeeper_device.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "migration/vmstate.h"
+#include "qemu/error-report.h"
+#include "qemu/typedefs.h"
+#include <dirent.h>
+#include <glib.h>
+#include <linux/fs.h>
+#include <sys/random.h>
+
+struct GatekeeperDeviceState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    MemoryRegion handles_table;
+    
+    uint32_t mode;
+    uint32_t status;
+    uint32_t len_dw;
+    uint32_t file_dw;
+    uint64_t pub_handle;
+    uint64_t priv_handle;
+
+    HandleTable *handle_table_ptr;
+    uint32_t total_entries_safe;
+    uint8_t file_buffer[MAX_FILE_SIZE];
+    uint32_t file_pos;
+    uint32_t created_files_count;
+
+    MemoryRegion *system_memory;
+};
+
+__attribute__((noinline)) static void add_table_entry(HandleEntry *table_ptr, uint64_t public_handle, uint64_t private_handle, uint32_t encrypted) {
+    table_ptr->public_handle = public_handle;
+    table_ptr->private_handle = private_handle;
+    table_ptr->encrypted = encrypted;
+}
+
+/* Function to ensure the directory exists */
+/*
+ * Per-run isolation: the executor points each QEMU instance at a private files
+ * directory and key file via these env vars, so participants never share state.
+ * Falls back to the compile-time defaults when unset.
+ */
+static const char *gk_files_dir(void) {
+    const char *e = getenv("GATEKEEPER_FILES");
+    return (e && *e) ? e : GATEKEEPER_FILES;
+}
+
+__attribute__((noinline)) static uint64_t ensure_dir(void) {
+    if (g_mkdir_with_parents(gk_files_dir(), 0755) < 0) {
+        return (uint64_t)-1;
+    }
+    return 0;
+}
+
+/*
+<8bytes hex><8bytes hex>.gk or .gk.enc (for encrypted)
+<private   ><public    >
+*/
+
+__attribute__((noinline))
+static uint64_t parse_filename(
+    const char *filename, 
+    uint64_t *priv_handle, 
+    uint64_t *pub_handle, 
+    uint32_t *encrypted
+) {
+    char priv_str[17] = {0};
+    char pub_str[17] = {0};
+    char sig[4] = {0};
+    
+    size_t len = strlen(filename);
+    if (len != 16 * 2 + 3) {
+        return (uint64_t)-1;
+    }
+
+    const char *ext = filename + 16 * 2;
+    if (strcmp(ext, ".gk")) {
+        return (uint64_t)-1;
+    }
+
+    char full_name[256] = {0};
+    snprintf(full_name, sizeof(full_name), "%s/%s", gk_files_dir(), filename);
+    FILE *fptr = fopen(full_name, "rb");
+    if (fptr == NULL) {
+        return (uint64_t)-1;
+    }
+
+    size_t size = fread(sig, 1, 4, fptr);
+    if (size != 4) {
+        fclose(fptr);
+        return (uint64_t)-1;
+    }
+
+    if (!strncmp("PLA", sig, 3)) {
+        *encrypted = 0;
+    }
+    else if (!strncmp("ENC", sig, 3)) {
+        *encrypted = 1;
+    }
+    else {
+        fclose(fptr);
+        return (uint64_t)-1;
+    }
+
+    memcpy(priv_str, filename, 16);
+    memcpy(pub_str, filename + 16, 16);
+    
+    *priv_handle = strtoull(priv_str, NULL, 16);
+    *pub_handle = strtoull(pub_str, NULL, 16);
+    
+    // fclose(fptr);
+
+    return 0;
+}
+
+__attribute__((noinline)) static void scan_directory(GatekeeperDeviceState *s) {
+    DIR *dir;
+    struct dirent *entry;
+    
+    if (ensure_dir() == (uint64_t)-1) {
+        return;
+    }
+    
+    dir = opendir(gk_files_dir());
+    if (!dir) {
+        return;
+    }
+    
+    while ((entry = readdir(dir)) != NULL) {
+        uint64_t priv_handle, pub_handle;
+        uint32_t encrypted;
+        
+        if (!parse_filename(entry->d_name, &priv_handle, &pub_handle, &encrypted)) {
+            if (s->total_entries_safe < (GATEKEEPER_HANDLES_SIZE / sizeof(HandleEntry) - 1)) {
+                HandleEntry *entry_ptr = &s->handle_table_ptr->entries[s->total_entries_safe];
+                add_table_entry(entry_ptr, pub_handle, priv_handle, encrypted);
+                s->handle_table_ptr->total_entries = ++s->total_entries_safe;
+            }
+        }
+    }
+    
+    closedir(dir);
+}
+
+__attribute__((noinline)) static uint64_t generate_random_handle(void) {
+    /*
+     * Handles are capability tokens, so they must be unpredictable. g_random_int()
+     * is a Mersenne Twister (not a CSPRNG); use the kernel CSPRNG via getrandom()
+     * instead. Retry on short reads / EINTR.
+     */
+    uint64_t handle = 0;
+    uint8_t *p = (uint8_t *)&handle;
+    size_t got = 0;
+    while (got < sizeof(handle)) {
+        ssize_t n = getrandom(p + got, sizeof(handle) - got, 0);
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            error_report("getrandom() failed while generating a handle");
+            exit(1);
+        }
+        got += (size_t)n;
+    }
+    return handle;
+}
+
+__attribute((noinline)) static uint64_t pub_from_private(GatekeeperDeviceState *s, uint64_t private_handle) {
+    for (size_t i = 0; i < s->total_entries_safe; ++i) {
+        if (s->handle_table_ptr->entries[i].private_handle == private_handle) {
+            return s->handle_table_ptr->entries[i].public_handle;
+        }
+    }
+
+    return 0;
+}
+
+__attribute__((noinline)) static void host_create_file_plain(GatekeeperDeviceState *s) {
+    s->pub_handle = generate_random_handle();
+    s->priv_handle = generate_random_handle();
+
+    char filename[256] = {0};
+    snprintf(filename, sizeof(filename), "%s/" "%016" PRIx64 "%016" PRIx64 ".gk", gk_files_dir(), s->priv_handle, s->pub_handle);
+    FILE *fptr = fopen(filename, "wb");
+    if (fptr == NULL) {
+        s->status = GATEKEEPER_ECREAT;
+        return ;
+    }
+
+    const char *signature = "PLA";
+
+    HandleEntry *entry_ptr = &s->handle_table_ptr->entries[s->total_entries_safe];
+    add_table_entry(entry_ptr, s->pub_handle, s->priv_handle, 0);
+    s->handle_table_ptr->total_entries = ++s->total_entries_safe;
+
+    fwrite(signature, 1, 4, fptr);
+    fwrite(s->file_buffer, 1, s->len_dw * 4, fptr);
+    s->status = GATEKEEPER_EOK;
+    s->created_files_count += 1;
+    fclose(fptr);
+}
+
+__attribute__((noinline)) static void host_read_file_plain(GatekeeperDeviceState *s) {
+    char filename[256] = {0};
+
+    uint64_t pub_handle = pub_from_private(s, s->priv_handle);
+    snprintf(filename, sizeof(filename), "%s/" "%016" PRIx64 "%016" PRIx64 ".gk", gk_files_dir(), s->priv_handle, pub_handle);
+    FILE *fptr = fopen(filename, "rb");
+    if (fptr == NULL) {
+        s->status = GATEKEEPER_ENOFILE;
+        return ;
+    }
+
+    fseek(fptr, 0, SEEK_END);
+    long file_size = ftell(fptr);
+    rewind(fptr);
+
+    char signature[4] = {0};
+    size_t sig_size = fread(signature, 1, 4, fptr);
+    if (sig_size != 4)  {
+        fclose(fptr);
+        s->status = GATEKEEPER_ECORRUPTED;
+        return ;
+    }
+    
+    /* Never read more than file_buffer can hold (defense-in-depth). */
+    size_t to_read = (size_t)file_size;
+    if (to_read > sizeof(s->file_buffer)) {
+        to_read = sizeof(s->file_buffer);
+    }
+    size_t num_read = fread(s->file_buffer, 1, to_read, fptr);
+    if (num_read != to_read) {
+        s->status = GATEKEEPER_ECORRUPTED;
+    }
+
+    s->len_dw = (num_read + 3) / 4;
+    fclose(fptr);
+    s->status = GATEKEEPER_EOK;
+    return ;
+}
+
+__attribute__((noinline)) static uint64_t gatekeeper_device_read(void *opaque, hwaddr addr, unsigned size) {
+    GatekeeperDeviceState *s = opaque;
+    uint64_t val = 0;
+
+    switch (addr) {
+    case GATEKEEPER_REG_STATUS:
+        val = s->status;
+        break;
+    case GATEKEEPER_REG_LENDW:
+        val = s->len_dw;
+        break;
+    case GATEKEEPER_REG_FILEDW:
+        if (s->file_pos < s->len_dw * 4 && s->file_pos + 4 <= sizeof(s->file_buffer)) {
+            memcpy((uint8_t *)&val, &s->file_buffer[s->file_pos], 4);
+            s->file_pos += 4;
+        }
+        break;
+    case GATEKEEPER_REG_PUB_HANDLE_LO:
+        val = s->pub_handle & 0xFFFFFFFF;
+        break;
+    case GATEKEEPER_REG_PUB_HANDLE_HI:
+        val = (s->pub_handle >> 32) & 0xFFFFFFFF;
+        break;
+    case GATEKEEPER_REG_PRIV_HANDLE_LO:
+        val = s->priv_handle & 0xFFFFFFFF;
+        break;
+    case GATEKEEPER_REG_PRIV_HANDLE_HI:
+        val = (s->priv_handle >> 32) & 0xFFFFFFFF;
+        break;
+    default:
+        break;
+    }
+
+    return val;
+}
+
+__attribute__((noinline)) static void gatekeeper_device_write(void *opaque, hwaddr addr, uint64_t val, unsigned size) {
+    GatekeeperDeviceState *s = opaque;
+
+    switch (addr) {
+    case GATEKEEPER_REG_MODE:
+        s->file_pos = 0;
+
+        if (val == MODE_CREATE_PLAIN && s->created_files_count == MAX_CREATED_FILES) {
+            s->status = GATEKEEPER_ENOSPACE;
+            break;
+        }
+
+        s->status = GATEKEEPER_EOK;
+        s->mode = val;
+
+        switch (s->mode) {
+            case MODE_READ_PLAIN:
+                memset(s->file_buffer, 0, sizeof(s->file_buffer));
+                host_read_file_plain(s);
+                break;
+            default:
+                break;
+        }
+        break;
+        
+    case GATEKEEPER_REG_LENDW:
+        s->len_dw = val;
+        /*
+         * Clamp so that len_dw * 4 can never exceed file_buffer. The length is
+         * otherwise fully attacker-controlled and would let the FILEDW
+         * read/write loops run past file_buffer into adjacent device state.
+         */
+        if (s->len_dw > MAX_FILE_SIZE / 4) {
+            s->len_dw = MAX_FILE_SIZE / 4;
+        }
+        break;
+        
+    case GATEKEEPER_REG_FILEDW:
+        if (s->file_pos < s->len_dw * 4 && s->file_pos + 4 <= sizeof(s->file_buffer)) {
+            s->file_dw = val;
+            memcpy(&s->file_buffer[s->file_pos], (uint8_t *)&val, 4);
+            s->file_pos += 4;
+        }
+
+        if (s->file_pos >= s->len_dw * 4) {
+            switch(s->mode) {
+                case MODE_CREATE_PLAIN:
+                    host_create_file_plain(s);
+                    break;
+                default:
+                    break;
+            }
+        }
+        
+        break;
+    
+    case GATEKEEPER_REG_PUB_HANDLE_LO:
+        s->pub_handle = (s->pub_handle & 0xFFFFFFFF00000000) | val;
+        break;
+        
+    case GATEKEEPER_REG_PUB_HANDLE_HI:
+        s->pub_handle = (val << 32) | (s->pub_handle & 0xFFFFFFFF);
+        break;
+        
+    case GATEKEEPER_REG_PRIV_HANDLE_LO:
+        s->priv_handle = (s->priv_handle & 0xFFFFFFFF00000000) | val;
+        break;
+        
+    case GATEKEEPER_REG_PRIV_HANDLE_HI:
+        s->priv_handle = (val << 32) | (s->priv_handle & 0xFFFFFFFF);
+        break;
+
+    default:
+        break;
+    }
+}
+
+static const MemoryRegionOps gatekeeper_device_ops = {
+    .read = gatekeeper_device_read,
+    .write = gatekeeper_device_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+__attribute__((noinline)) static void gatekeeper_device_realize(DeviceState *dev, Error **errp) {
+    GatekeeperDeviceState *s = GATEKEEPER_DEVICE(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_io(
+        &s->mmio, 
+        OBJECT(s),
+        &gatekeeper_device_ops,
+        s,
+        "gatekeeeper.device",
+        GATEKEEPER_DEVICE_SIZE
+    );
+
+    sysbus_init_mmio(sbd, &s->mmio);
+    
+    memory_region_init_ram(
+        &s->handles_table, 
+        NULL, 
+        "gatekeeper.handles", 
+        GATEKEEPER_HANDLES_SIZE, 
+        &error_fatal
+    );
+
+    memory_region_add_subregion(
+        s->system_memory, 
+        GATEKEEPER_HANDLES_BASE, 
+        &s->handles_table
+    );
+    
+    s->handle_table_ptr = (HandleTable *)memory_region_get_ram_ptr(&s->handles_table);
+    s->total_entries_safe = 0;
+    s->handle_table_ptr->total_entries = 0;
+    
+    scan_directory(s);
+
+    s->created_files_count = 0;
+}
+
+__attribute__((noinline)) static void gatekeeper_device_unrealize(DeviceState *dev) {
+    GatekeeperDeviceState *s = GATEKEEPER_DEVICE(dev);
+    
+    if (s->handle_table_ptr) {
+        memset(s->handle_table_ptr, 0, GATEKEEPER_HANDLES_SIZE);
+    }
+}
+
+static const Property gatekeeper_device_props[] = {
+    DEFINE_PROP_LINK("system-memory", GatekeeperDeviceState, system_memory,
+                     TYPE_MEMORY_REGION, MemoryRegion *),
+};
+
+static void gatekeeper_device_class_init(ObjectClass *klass, const void *data) {
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = gatekeeper_device_realize;
+    dc->unrealize = gatekeeper_device_unrealize;
+    dc->desc = "Gatekeeper device";
+
+    device_class_set_props(dc, gatekeeper_device_props);
+}
+
+static const TypeInfo gatekeeper_device_info = {
+    .name = TYPE_GATEKEEPER_DEVICE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(GatekeeperDeviceState),
+    .class_init = gatekeeper_device_class_init,
+};
+
+static void gatekeeper_device_register_types(void) {
+    type_register_static(&gatekeeper_device_info);
+}
+
+type_init(gatekeeper_device_register_types)
